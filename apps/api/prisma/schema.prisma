// Prisma Schema for Master Legends League

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(uuid())
  email            String?   @unique @db.VarChar(255)
  username         String?   @unique @db.VarChar(20)
  password         String?   @db.VarChar(255)
  wallet           String?   @unique @db.VarChar(42)
  avatarUrl        String?   @db.VarChar(512)
  referralCode     String    @unique @db.VarChar(8)
  referredBy       String?   @db.VarChar(42)
  nonce            String?   @db.VarChar(64)
  emailVerifiedAt       DateTime?
  tutorialCompletedAt   DateTime?
  // Telegram bot link (Genesis DAO / MLL notifications)
  telegramChatId          String?   @unique @db.VarChar(64)
  telegramLinkedAt        DateTime?
  telegramNotifyEnabled   Boolean   @default(true)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  bannedAt         DateTime?
  banReason        String?   @db.VarChar(255)
  bannedBy         String?   @db.VarChar(64)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  club                   Club?
  passProgress           PassProgress[]
  missionProgress        MissionProgress[]
  mgtBalance             MGTBalance?
  basePlayers            BasePlayer[]
  referralsMade          Referral[]                  @relation("referrer")
  referralsGot           Referral[]                  @relation("referred")
  commissionsMade        ReferralCommission[]        @relation("commissionReferrer")
  commissionsGot         ReferralCommission[]        @relation("commissionReferred")
  listings               Listing[]
  stakes                 Stake[]
  playerStakes           PlayerStake[]
  playerFieldTrials      PlayerFieldTrial[]
  emailTokens            EmailVerificationToken[]
  resetTokens            PasswordResetToken[]
  auditLogs              AuditLog[]
  walletTransactions     WalletTransaction[]
  depositClaims          DepositClaim[]
  mgtTransactions        MGTTransaction[]
  minigamePlays          MinigamePlay[]
  withdrawalRequests     WithdrawalRequest[]
  supportTickets         SupportTicket[]
  announcementDismissals UserAnnouncementDismissal[]
  miningBalance          MiningBalance?
  miningRewards          MiningReward[]
  youtubeCreator         YoutubeCreator?
  ipEvents               UserIpEvent[]
  afflictions            Affliction[]
  checkInGrants          CheckInGrant[]
  checkInStreakRewards   CheckInStreakReward[]
  questProgress          QuestProgress[]
  questClaims            QuestClaim[]
  questClaimLogs         QuestClaimLog[]
  userBadges             UserBadge[]
  eventOverwallGrants    EventOverwallGrant[]
  eventTriggerCooldowns  EventTriggerCooldown[]
  userGears              UserGear[]
  playerGearEquips       PlayerGearEquip[]
  warehouseItems         WarehouseItem[]
  offerwallRewards       OfferwallReward[]
  zeradsPtcCallbacks     ZeradsPtcCallback[]
  staminaLedger          StaminaLedger[]
  ctRecords              CtRecord[]
  mintRecords            MintRecord[]
  mergeRecords           MergeRecord[]
  bonecoLooks            BonecoLook[]
  pvpListingsHosted      PvpListing[] @relation("pvpHost")
  pvpListingsJoined      PvpListing[] @relation("pvpChallenger")
}

model BonecoLook {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playerId   String   @db.VarChar(64)
  playerKind String   @db.VarChar(8)
  imageUrl   String   @db.VarChar(512)
  position   String   @db.VarChar(8)
  kit        String   @db.VarChar(16)
  trim       String   @db.VarChar(16)
  pose       String   @db.VarChar(24)
  note       String   @default("") @db.VarChar(400)
  updatedAt  DateTime @updatedAt

  @@unique([userId, playerKind, playerId])
  @@index([userId])
}

model Affliction {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetKind String   @db.VarChar(16)
  targetId   String?  @db.VarChar(64)
  code       String   @db.VarChar(64)
  note       String?  @db.VarChar(255)
  startedAt  DateTime @default(now())
  expiresAt  DateTime
  createdBy  String?  @db.VarChar(64)

  @@index([userId, targetKind, expiresAt])
  @@index([expiresAt])
}

model UserIpEvent {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip         String   @db.VarChar(64)
  userAgent  String?  @db.VarChar(512)
  fingerprint String? @db.VarChar(128)
  action     String   @db.VarChar(20)
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([ip])
}

model CheckInGrant {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Int      @default(1)
  checkInDay DateTime @db.Date
  grantedAt  DateTime @default(now())
  expiresAt  DateTime

  @@unique([userId, checkInDay])
  @@index([userId, expiresAt])
}

model CheckInStreakReward {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestone  Int
  checkInDay DateTime @db.Date
  playerId   String?
  createdAt  DateTime @default(now())

  @@unique([userId, milestone])
  @@index([userId, createdAt])
}

model EmailVerificationToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @db.VarChar(128)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model EmailCampaign {
  id               String   @id @default(cuid())
  subject          String   @db.VarChar(200)
  body             String   @db.Text
  audience         String   @db.VarChar(16)
  targetUsername   String?  @db.VarChar(64)
  queuedCount      Int      @default(0)
  createdByAdminId String?  @db.VarChar(64)
  createdAt        DateTime @default(now())

  @@index([createdAt])
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @db.VarChar(128)
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?   @db.VarChar(45)
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   @db.VarChar(64)
  severity  String   @default("info") @db.VarChar(16)
  ip        String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(255)
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId, action])
  @@index([action, createdAt])
}

model Club {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String   @unique @db.VarChar(32)
  stadiumLvl    Int      @default(1)
  ctLvl         Int      @default(1)
  treasurerLvl  Int      @default(1)
  trophyRoomLvl Int      @default(1)
  totalOverwall    Int       @default(0)
  lastFarmAt       DateTime  @default(now())
  lastDailyRestAt  DateTime?
  treasurerHiredAt  DateTime?
  treasurerLastBilledAt DateTime?
  coachHiredAt      DateTime?
  coachLastBilledAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  homePvpMatches PvPMatch[] @relation("clubA")
  awayPvpMatches PvPMatch[] @relation("clubB")
  lineup         ClubLineup?
  trophies       ClubTrophy[]
  stadiumLicenses ClubStadiumLicense[]
}

model PlayerCache {
  tokenId          BigInt   @id
  ownerWallet      String   @db.VarChar(42)
  rarity           Int
  overwall         Int
  stamina          Int
  position         Int
  attributes       Json?
  traitsHash       String?  @db.VarChar(66)
  staminaUpdatedAt DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([ownerWallet])
  @@index([rarity])
  @@index([position])
}

model BasePlayer {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  rarity     Int           @default(0)
  overwall   Int
  position   Int
  attributes Json?
  name       String?       @db.VarChar(64)
  imageUrl   String?       @db.VarChar(512)
  templateId String?
  template   ItemTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  listed             Boolean       @default(false)
  stamina            Int           @default(100)
  staminaUpdatedAt   DateTime      @default(now())
  createdAt          DateTime      @default(now())
  source             String        @default("scout") @db.VarChar(32)
  fieldedAt          DateTime?
  expiresAt          DateTime?
  retiredAt          DateTime?
  /// Acquisition cost in USDC-equivalent (GMT ~ USDC). 0 = no ROI career cycle.
  costBasisUsdc      Decimal       @default(0) @db.Decimal(36, 6)
  /// Cumulative mining USDC attributed while on the XI.
  lifetimeEarnedUsdc Decimal       @default(0) @db.Decimal(36, 6)
  listing            Listing?

  @@index([userId])
  @@index([templateId])
  @@index([userId, stamina])
  @@index([expiresAt])
}

model StaminaLedger {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playerKind String   @db.VarChar(8)
  playerId   String   @db.VarChar(64)
  reason     String   @db.VarChar(16)
  delta      Int
  before     Int
  after      Int
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([playerKind, playerId, createdAt])
}

model CtRecord {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playerKind String?  @db.VarChar(8)
  playerId   String?  @db.VarChar(64)
  kind       String   @db.VarChar(16)
  before     Int?
  after      Int?
  detail     String?  @db.VarChar(64)
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([playerKind, playerId, createdAt])
}

model MinigamePlay {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  minigameId String   @db.VarChar(32)
  playedAt   DateTime @default(now())

  @@index([userId, minigameId, playedAt])
}

model StadiumShopItem {
  id               String   @id @default(uuid())
  slug             String   @unique @db.VarChar(64)
  nameKey          String   @db.VarChar(128)
  effectType       String   @db.VarChar(20)
  effectValue      Int      @default(0)
  priceUsdc        Decimal  @db.Decimal(18, 6)
  active           Boolean  @default(true)
  sortOrder        Int      @default(0)
  // affiliate / external product fields
  imageUrl         String?  @db.VarChar(512)
  affiliateUrl     String?  @db.VarChar(1024)
  description      String?  @db.VarChar(512)
  externalPlatform String?  @db.VarChar(32)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([active, sortOrder])
}

/// Catalog of wearable gear (boots, etc.) sold in the stadium shop.
model GearCatalogItem {
  id          String   @id @default(uuid())
  slug        String   @unique @db.VarChar(64)
  nameKey     String   @db.VarChar(128)
  slot        String   @db.VarChar(32) // boots | gloves | shinguards…
  rarity      Int      @default(0) // 0–5, same scale as player cards
  owBonus     Int      @default(0)
  priceGmt    Decimal  @db.Decimal(18, 6)
  imageUrl    String?  @db.VarChar(512)
  description String?  @db.VarChar(512)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerships UserGear[]

  @@index([active, slot, sortOrder])
  @@index([active, rarity])
}

/// Owned gear instance in a user's bag.
model UserGear {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogItemId String
  catalogItem   GearCatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  source        String   @default("shop") @db.VarChar(32) // shop | admin | event
  acquiredAt    DateTime @default(now())

  equip PlayerGearEquip?

  @@index([userId])
  @@index([catalogItemId])
}

/// Equipped gear on a specific player (one item per slot).
model PlayerGearEquip {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playerId   String   @db.VarChar(64)
  playerKind String   @db.VarChar(8) // base | nft
  slot       String   @db.VarChar(32)
  userGearId String   @unique
  userGear   UserGear @relation(fields: [userGearId], references: [id], onDelete: Cascade)
  equippedAt DateTime @default(now())

  @@unique([userId, playerId, playerKind, slot])
  @@index([userId, playerId])
}

model ItemTemplate {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(64)
  imageUrl  String   @db.VarChar(512)
  rarity    Int
  position  Int
  overwall  Int
  weight    Int      @default(1)
  active    Boolean  @default(true)
  createdBy String?  @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  basePlayers BasePlayer[]
  marketSupply MarketSupply?

  @@index([active, rarity])
}

/// Estoque oficial da liga no marketplace. Cada compra entrega uma cópia e baixa `remaining`.
model MarketSupply {
  id         String       @id
  templateId String       @unique
  template   ItemTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  initialQty Int
  remaining  Int
  priceGmt   Decimal      @db.Decimal(36, 6)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([remaining])
}

model StadiumTemplate {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(64)
  imageUrl  String   @db.VarChar(512)
  slots     Json
  priceUsdc Decimal? @db.Decimal(18, 6)
  active    Boolean  @default(false)
  isDefault Boolean  @default(false)
  sortOrder Int      @default(0)
  farmBonusPct Decimal @default(0.05) @db.Decimal(8, 4)
  /// Quantidade mínima de jogadores Rare+ no elenco para comprar/ativar (0 = sem requisito)
  requireRareStarters Int @default(11)
  /// Overwall mínimo (escalação + bônus) para comprar/ativar (0 = sem requisito)
  requireMinOverwall  Int @default(0)
  /// Precisa já ter licença assinada deste outro estádio
  requireOwnedTemplateId String?
  requireOwnedTemplate   StadiumTemplate?  @relation("StadiumUnlockPrereq", fields: [requireOwnedTemplateId], references: [id], onDelete: SetNull)
  unlocksFor             StadiumTemplate[] @relation("StadiumUnlockPrereq")
  /// Texto opcional exibido ao jogador (ex: "Só após Campo da 4ª Divisão")
  requirementNote String? @db.VarChar(280)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineups  ClubLineup[]
  licenses ClubStadiumLicense[]

  @@index([active, sortOrder])
}

/// Licença de uso do campo — compra USDC + assinatura de contrato no Escritório.
model ClubStadiumLicense {
  id                String   @id @default(uuid())
  clubId            String
  club              Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  stadiumTemplateId String
  stadiumTemplate   StadiumTemplate @relation(fields: [stadiumTemplateId], references: [id], onDelete: Restrict)
  /// purchased = pago aguardando assinatura | signed = licenciado (pode ativar)
  status            String   @db.VarChar(16)
  pricePaidUsdc     Decimal? @db.Decimal(18, 6)
  purchasedAt       DateTime?
  signedAt          DateTime?
  contractVersion   String?  @db.VarChar(32)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([clubId, stadiumTemplateId])
  @@index([clubId, status])
}

model VestiarioTemplate {
  id             String   @id @default(uuid())
  name           String   @default("Vestiário Padrão") @db.VarChar(64)
  imageUrl       String   @db.VarChar(512)
  backgroundType String   @default("image") @db.VarChar(8)
  slots          Json
  active         Boolean  @default(true)
  isDefault      Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([active, sortOrder])
}

model ClubLineup {
  clubId            String          @id
  club              Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  stadiumTemplateId String
  stadiumTemplate   StadiumTemplate @relation(fields: [stadiumTemplateId], references: [id], onDelete: Restrict)
  assignments       Json
  updatedAt         DateTime        @updatedAt

  @@index([stadiumTemplateId])
}

model MGTBalance {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount           Decimal  @default(0) @db.Decimal(36, 18) // GMT disponível
  lockedAmount     Decimal  @default(0) @db.Decimal(36, 18) // GMT bloqueado
  usdcAmount       Decimal  @default(0) @db.Decimal(36, 18) // USDC — depósito / swap pool (→ GMT)
  usdtAmount       Decimal  @default(0) @db.Decimal(36, 18) // USDT disponível
  usdtLockedAmount Decimal  @default(0) @db.Decimal(36, 18) // USDT bloqueado em saque pendente
  updatedAt        DateTime @updatedAt
}

model WalletTransaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   @db.VarChar(32)
  amount      Decimal  @db.Decimal(36, 6)
  txHash      String   @unique @db.VarChar(66)
  blockNumber BigInt?
  status      String   @default("confirmed") @db.VarChar(16)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model DepositClaim {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  txHash        String    @unique @db.VarChar(66)
  status        String    @default("pending") @db.VarChar(16) // pending | queued | credited | failed | rejected
  failReason    String?   @db.VarChar(64)
  attemptCount  Int       @default(0)
  lastCheckedAt DateTime?
  creditedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, lastCheckedAt])
  @@index([userId, createdAt])
}

model RoadmapPhase {
  id        String        @id @default(uuid())
  order     Int           @default(0)
  status    String        @db.VarChar(16) // done | active | upcoming
  color     String        @db.VarChar(32)
  visible   Boolean       @default(true)
  i18n      Json
  items     RoadmapItem[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([order])
}

model RoadmapItem {
  id        String       @id @default(uuid())
  phaseId   String
  phase     RoadmapPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  order     Int          @default(0)
  done      Boolean      @default(false)
  visible   Boolean      @default(true)
  i18n      Json
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([phaseId, order])
}

model MGTTransaction {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String   @db.VarChar(32)
  amount       Decimal  @db.Decimal(36, 18)
  balanceAfter Decimal  @db.Decimal(36, 18)
  meta         Json?
  createdAt    DateTime @default(now())
  mintRecords  MintRecord[]
  mergeRecords MergeRecord[]

  @@index([userId, createdAt])
}

model MergeRecord {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet           String?        @db.VarChar(42)
  cost             Decimal        @db.Decimal(36, 6)
  sources          Json
  overwallBefore   Int
  resultPlayerId   String         @db.VarChar(64)
  overwallAfter    Int
  mgtTransactionId String
  mgtTransaction   MGTTransaction @relation(fields: [mgtTransactionId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@index([userId, createdAt])
  @@index([mgtTransactionId])
  @@index([resultPlayerId])
}

model MintRecord {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet           String?        @db.VarChar(42)
  cost             Decimal        @db.Decimal(36, 6)
  basePlayerId     String         @db.VarChar(64)
  rarity           Int
  attributes       Json
  mgtTransactionId String
  mgtTransaction   MGTTransaction @relation(fields: [mgtTransactionId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@index([userId, createdAt])
  @@index([mgtTransactionId])
  @@index([basePlayerId])
}

model Stake {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount            Decimal   @db.Decimal(36, 18)
  stakedAt          DateTime  @default(now())
  lastRewardAt      DateTime
  accumulatedReward Decimal   @default(0) @db.Decimal(36, 18)
  status            String    @default("active") // active, unstaked
  unstakedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@index([userId, status])
}

// GMT locked on a base/NFT player so they can enter the XI.
model PlayerStake {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String    @db.VarChar(8) // base | nft
  playerId   String    @db.VarChar(64)
  amount     Decimal   @db.Decimal(36, 8)
  status     String    @default("active") @db.VarChar(16) // active | unstaked
  stakedAt   DateTime  @default(now())
  unstakedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([kind, playerId])
  @@index([userId, status])
}

// Unstaked pitch window. Starts when the player enters; 5 minutes on, then locked until 24h.
model PlayerFieldTrial {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            String   @db.VarChar(8) // base | nft
  playerId        String   @db.VarChar(64)
  windowStartedAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([kind, playerId])
  @@index([userId])
}

model PvpListing {
  id                   String    @id @default(uuid())
  hostUserId           String
  host                 User      @relation("pvpHost", fields: [hostUserId], references: [id], onDelete: Cascade)
  hostClubName         String    @db.VarChar(32)
  tierId               String    @db.VarChar(16)
  stakeGmt             Decimal   @db.Decimal(36, 6)
  hostOverwall         Decimal   @db.Decimal(18, 4)
  status               String    @default("open") @db.VarChar(16)
  challengerUserId     String?
  challenger           User?     @relation("pvpChallenger", fields: [challengerUserId], references: [id], onDelete: SetNull)
  challengerClubName   String?   @db.VarChar(32)
  challengerOverwall   Decimal?  @db.Decimal(18, 4)
  winnerUserId         String?
  result               String?   @db.VarChar(16)
  createdAt            DateTime  @default(now())
  settledAt            DateTime?

