  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType    String    @db.VarChar(32) // player_card | consumable | stamina_boost | gmt_pack | scout_ticket
  name        String    @db.VarChar(128)
  description String?   @db.VarChar(512)
  imageUrl    String?   @db.VarChar(512)
  rarity      Int       @default(0)
  quantity    Int       @default(1)
  data        Json      @default("{}")
  source      String    @db.VarChar(32) // marketplace | quest_reward | checkin | admin | offerwall
  sourceRef   String?   @db.VarChar(128)
  claimed     Boolean   @default(false)
  claimedAt   DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, claimed])
  @@index([userId, source])
  @@index([expiresAt])
}

/// Recompensas de offerwall (Zerads) creditadas ao usuário.
model OfferwallReward {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String    @db.VarChar(32) // zerads
  transactionId String   @unique @db.VarChar(128)
  amount       Decimal   @db.Decimal(18, 6)
  currency     String    @db.VarChar(8) // GMT | USDC
  status       String    @default("completed") @db.VarChar(16) // completed | reversed
  userIp       String?   @db.VarChar(45)
  callbackRaw  Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, provider])
  @@index([transactionId])
}

/// Log bruto de cada callback PTC do Zerads (~5 min) — guarda o `clicks` real que eles
/// enviam, separado do EventOverwallGrant (que só cuida do crédito de Overwall).
model ZeradsPtcCallback {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodKey  String   @db.VarChar(32)
  zerAmount  Decimal  @db.Decimal(18, 6)
  clicks     Int      @default(0)
  overwall   Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([userId, periodKey])
  @@index([userId, createdAt])
}
