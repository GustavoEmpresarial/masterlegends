model QuestDefinition {
  id                    String    @id @default(uuid())
  kind                  String    @db.VarChar(32) // event_task | daily_task | weekly_task | achievement
  campaignId            String?
  campaign              EventCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  title                 String    @db.VarChar(200)
  description           String    @db.Text
  trigger               String    @db.VarChar(64)
  target                Int       @default(1)
  rewards               Json
  active                Boolean   @default(true)
  startsAt              DateTime?
  endsAt                DateTime?
  maxClaimsPerUser      Int       @default(1)
  maxGlobalClaims       Int?
  requireEmailVerified  Boolean   @default(true)
  period                String    @default("none") @db.VarChar(16) // none | daily | weekly
  sortOrder             Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  progress QuestProgress[]
  claims   QuestClaim[]
  logs     QuestClaimLog[]

  @@index([active, kind, sortOrder])
  @@index([trigger, active])
  @@index([campaignId])
}

