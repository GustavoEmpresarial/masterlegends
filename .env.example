# ===========================================
# Master Legends League - Environment Variables
# ===========================================

# ====================
# Backend (apps/api)
# ====================

# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
WEB_URL=http://localhost:5173
SOCKET_PATH=/socket.io
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mll

# Redis
REDIS_URL=redis://localhost:6379

# MongoDB (operational logs — high volume)
MONGO_PASSWORD=your-mongodb-password-change-in-production
MONGODB_URI=mongodb://mll_mongo:your-mongodb-password-change-in-production@localhost:27017/mll_logs?authSource=admin
LOG_MONGO_ENABLED=true
LOG_MONGO_TTL_DAYS=90
LOG_MONGO_BATCH_SIZE=100
LOG_MONGO_FLUSH_MS=2000

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
# Required in production — must differ from JWT_SECRET
ADMIN_JWT_SECRET=your-admin-jwt-secret-change-in-production-min-32-chars
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d
REFRESH_TOKEN_MAX_AGE_SECONDS=2592000
# Required in production — must differ from JWT_SECRET
COOKIE_SECRET=your-cookie-signing-secret-min-32-chars-change-me

# SMTP (API enqueues; worker delivers via Hostinger)
# Production: smtp.hostinger.com:465 (SSL/TLS)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@masterlegends.online
SMTP_PASS=your-mailbox-password
SMTP_FROM=Master Legends League <no-reply@masterlegends.online>
# Marketing SMTP quotas (transactional emails ignore these)
EMAIL_MARKETING_DAILY_LIMIT=250
EMAIL_MARKETING_PER_MINUTE=8

# Telegram bot (MLL / Genesis DAO notifications) — enable when bot token is ready
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_GLOBAL_CHAT_ID=
# Forum topic id inside the group (message_thread_id), e.g. 847
TELEGRAM_GLOBAL_THREAD_ID=
# polling = getUpdates (recommended behind Cloudflare); webhook = HTTPS callback
TELEGRAM_UPDATES_MODE=polling

# MLL FAQ bot (OpenAI-compatible via OpenCode Go) — answers questions in Telegram public chat / DM
# Primary: DeepSeek V4 Pro. Fallbacks: MiMo + other OpenCode Go models.
# Periodic tip in public chat: call bot with @ (default every 1h; skips weekends and 22h-6h Brasilia; empty thread = General)

# Auth features
ENABLE_WEB3_AUTH=false

# Cloudflare Turnstile (login/register — API secret + web site key)
TURNSTILE_SECRET_KEY=

# Prisma context guard (dev/test only — disables ALS query blocking)
# PRISMA_GUARD_DISABLED=true

# Admin operators (JSON array) — plaintext passwords DEV ONLY; never commit real secrets
# On the VM this line lives in .env.admin, with each $ written as $$.
ADMIN_USERS=[{"id":"admin-main","login":"admin","password":"MllAdmin2026","email":"admin@mll.local","role":"super"}]
ADMIN_ALLOW_PLAINTEXT_PASSWORDS=true
ADMIN_2FA_DISABLED=true
ADMIN_2FA_TTL_SECONDS=300
ADMIN_2FA_CODE_LENGTH=6
ADMIN_JWT_EXPIRY=15m
ADMIN_REFRESH_MAX_AGE_SECONDS=28800

# Polygon Network
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
POLYGONSCAN_API_KEY=your-polygonscan-api-key
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-5-0-flash,recraft/recraft-v4.1-flash,inclusionai/ming-image-0.1-design
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
CHAIN_ID=137

# Deployer Private Key (for contract interactions)
DEPLOYER_PRIVATE_KEY=0x...

# Contract Addresses (fill after deployment — npm run sync:contracts:env hardhat)
CONTRACT_MGT=0x...
CONTRACT_PLAYER_NFT=0x...
CONTRACT_SCOUT=0x...
CONTRACT_BURN=0x...
CONTRACT_MARKETPLACE=0x...
CONTRACT_STAKING=0x...
CONTRACT_REWARDS_POOL=0x...
CONTRACT_USDC_VAULT=0x...
USDC_ADDRESS=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359
# USDT (Polygon) — pagamento de mineração e saques (a partir de 01/08/2026)
USDT_ADDRESS=0xc2132D05D31c914a87C6611C10748AEb04B58e8F
# SatsPay payouts — chave com escopos send e balance. Não commitar o valor.
SATSPAY_API_BASE=https://www.satspay.pro
SATSPAY_API_KEY=

# Chainlink VRF (ScoutEngine — fase 2)
VRF_COORDINATOR=0x...
VRF_KEY_HASH=0x...
VRF_SUBSCRIPTION_ID=...

# IPFS (Pinata)
PINATA_JWT=your-pinata-jwt
PINATA_GATEWAY=https://gateway.pinata.cloud

# Sentry (optional — production error tracking)
SENTRY_DSN=

# Bull Board queue dashboard (dev/staging only; blocked in production)
ENABLE_BULL_BOARD=false
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=

# Game Backend Wallet
GAME_ROLE_KEY=private-key-for-backend-wallet

# ====================
# Worker (apps/worker)
# ====================
# Uses DATABASE_URL, REDIS_URL, MONGODB_URI, LOG_*, SMTP_* and TELEGRAM_* from above.
# Run locally: npm run dev:worker

# ====================
# Frontend (apps/web)
# ====================
# Leave empty in Docker prod (nginx same-origin). Dev default: http://localhost:3001

VITE_API_URL=http://localhost:3001
VITE_SOCKET_PATH=/socket.io
VITE_CHAIN_ID=137
VITE_RPC_URL=https://polygon-bor-rpc.publicnode.com

# Web3 (fase 2 — ADR-0005)
VITE_WC_PROJECT_ID=
VITE_CONTRACT_PLAYER_NFT=
VITE_CONTRACT_SCOUT=
VITE_CONTRACT_MARKETPLACE=
VITE_CONTRACT_STAKING=
VITE_USDC=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359
VITE_USDT=0xc2132D05D31c914a87C6611C10748AEb04B58e8F
VITE_CONTRACT_USDC_VAULT=0x...

# Cloudflare Turnstile site key (public — login/register widget)
VITE_TURNSTILE_SITE_KEY=

# Google Analytics 4 (loaded only after cookie consent)
VITE_GA_MEASUREMENT_ID=

# Footer social links (optional)
VITE_DISCORD_URL=
VITE_TELEGRAM_URL=
VITE_GENESIS_DAO_URL=

# ====================
# Smart Contracts (apps/contracts)
# ====================

ALCHEMY_API_KEY=your-alchemy-api-key
POLYGONSCAN_API_KEY=your-polygonscan-api-key
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-5-0-flash,recraft/recraft-v4.1-flash,inclusionai/ming-image-0.1-design

# ====================
# Offerwall Zerads (PTC — paid to click, credita Overwall temporário)
# ====================
OFFERWALL_ZERADS_ENABLED=false
OFFERWALL_ZERADS_API_KEY=
OFFERWALL_ZERADS_SECRET_KEY=
OFFERWALL_ZERADS_SITE_ID=11807
# Senha do callback (?pwd=) configurada no painel Zerads > Publisher PTC > API URL Callback.
OFFERWALL_ZERADS_PTC_PASSWORD=
# 1 ZER ganho no PTC = quantos pontos de Overwall temporário (base configurável).
OFFERWALL_ZERADS_ZER_TO_OW=500
# Duração do bônus de Overwall do PTC, em horas (mesmo padrão do check-in: temporário).
OFFERWALL_ZERADS_OW_TTL_HOURS=24
